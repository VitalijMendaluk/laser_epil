# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laser_studio?schema=public"

# Optional. Public URL of the site (sitemap, canonical, Open Graph). On Vercel the project domain is used automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Secret for signing admin sessions (openssl rand -base64 48).
# If empty, a key derived from DATABASE_URL is used.
AUTH_SECRET=""

# Optional. First admin account created by the seed. Defaults: login "admin", password "1".
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="1"

# Optional. Cloudinary for image uploads. If empty, uploaded images are stored in PostgreSQL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="vizuali"

# Cloudflare Turnstile (spam protection for the booking form). Both empty → captcha disabled.
# https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Telegram notifications about new bookings (optional).
# Token from @BotFather; chat id of a person/group that has started the bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
